{
  "name": "notr",
  "version": "0.1.0",
  "description": "A digital implementation of *Nuns on the Run* for phones, tablets, laptops, and a 55-inch tabletop touchscreen, with private player information on companion phones.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:rules": "node --experimental-strip-types --test tests/firestore.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test": "npm run test:prompt-policy && npm run test:unit && npm run test:rules && npm run test:e2e",
    "emulators": "firebase emulators:start --project demo-notr --only auth,firestore",
    "test:emulators": "firebase emulators:exec --project demo-notr --only auth,firestore \"npm test\"",
    "prepare": "husky",
    "test:prompt-policy": "node --test scripts/check-prompts.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anicolao/notr.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "bugs": {
    "url": "https://github.com/anicolao/notr/issues"
  },
  "homepage": "https://github.com/anicolao/notr#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "firebase-tools": "^15.36.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
